APP_NAME=Scripture RAG API
APP_VERSION=0.1.0
API_PREFIX=/api/v1

QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT_SECONDS=60
COLLECTION_EN=scriptures_en
COLLECTION_HI=scriptures_hi
VECTOR_SIZE=1024

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
OPENAI_API_KEY=
EMBEDDING_LOCAL_FILES_ONLY=true
EMBEDDING_FALLBACK_PROVIDER=hash

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

SQLITE_PATH=app.db
LOG_LEVEL=INFO
ADMIN_TOKEN=change-me

RETRIEVAL_K_DEFAULT=6
RETRIEVAL_K_MAX=12
MIN_SIMILARITY=0.35
CROSS_COLLECTION_SIMILARITY=0.45
QUOTE_MAX_CHARS=240

DATA_DIR=data
UPANISHADS_PATH=data/108-upanishads.pdf
PURANAS_PATH=data/18 Puranas.pdf
RIGVED_PATH=data/rigved.pdf
YAJURVED_PATH=data/yajurved.pdf
SAMVED_PATH=data/samved.pdf
ARTHVED_PATH=data/arthved-part-1.pdf
ATHARVA2_PATH=data/atharva-2.pdf

OCR_LANGUAGES=hin+san
OCR_DPI=240
